PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/Aviraj _pos
JWT_SECRET=change-this-secret
JWT_EXPIRES=12h
CLIENT_URL=http://localhost:5173

# Backups: set BACKUP_ENABLED=true to run daily at 02:00 (change BACKUP_CRON). Files go to BACKUP_DIR.
BACKUP_ENABLED=false
BACKUP_CRON=0 2 * * *
BACKUP_DIR=./backups
BACKUP_KEEP=14
NODE_ENV=development
